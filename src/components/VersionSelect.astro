---
import { DOC_VERSIONS, UNVERSIONED_VERSION, COMPONENT_VERSIONS } from '../config/versions';

interface Props {
  /** When set, shows per-component versions instead of global doc tracks. */
  componentSlug?: string;
  /** Component display name (e.g., "Button"). Used when componentSlug is set. */
  componentName?: string;
}

const { componentSlug, componentName } = Astro.props;

const componentVersions = componentSlug ? COMPONENT_VERSIONS[componentSlug] : undefined;

// Use component-level versions when available, otherwise fall back to global tracks.
const versions = componentVersions ?? DOC_VERSIONS;
const unversionedVersion = UNVERSIONED_VERSION;

// For component versions, pass the path map so the script can navigate directly.
const componentPathMap = componentVersions
  ? Object.fromEntries(componentVersions.map((v) => [v.value, v.path]))
  : null;
const currentComponentVersion = componentVersions?.find((v) => v.isCurrent)?.value ?? null;
const currentVersionLabel = versions.find((v) => v.isCurrent)?.label ?? null;
---

<div class="version-wrap">
  <select id="version-select" class="version-select">
    {versions.map((v) => <option value={v.value}>{v.label}</option>)}
  </select>
</div>

<script define:vars={{ versions, unversionedVersion, componentPathMap, currentComponentVersion }}>
  const sel = document.getElementById('version-select');

  if (componentPathMap) {
    // ── Component-level version mode ──────────────────────────────────────
    // Pre-select the option whose path matches the current URL.
    const currentPath = window.location.pathname;
    const active = versions.find((v) => currentPath === componentPathMap[v.value]);
    if (active) sel.value = active.value;
    else if (currentComponentVersion) sel.value = currentComponentVersion;

    sel.addEventListener('change', () => {
      const newPath = componentPathMap[sel.value];
      window.location.href = newPath;
    });
  } else {
    // ── Global doc-track mode ──────────────────────────────────────────────
    const versionedMatch = window.location.pathname.match(/^\/(v\d+)\//);
    const isUnversionedPath = /^\/components\//.test(window.location.pathname);

    if (versionedMatch) sel.value = versionedMatch[1];
    else if (isUnversionedPath) sel.value = unversionedVersion;

    sel.addEventListener('change', () => {
      const chosen = sel.value;
      const path = window.location.pathname;
      const bare = path.replace(/^\/(v\d+\/)?/, '');
      const newPath = chosen === unversionedVersion
        ? `/${bare}`
        : `/${chosen}/${bare}`;
      window.location.pathname = newPath;
    });
  }
</script>

<style>
  .version-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .version-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
  }
  .version-select {
    font-size: 0.8rem;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    appearance: auto;
  }
</style>
