---
// Versions defined here — add new entries as you release new versions
const versions = [
  { value: 'v21', label: 'v21 (current)' },
  { value: 'v20', label: 'v20' },
  // { value: 'v22', label: 'v22' },
];
---

<div class="version-wrap">
  <label class="version-label" for="version-select">Version</label>
  <select id="version-select" class="version-select">
    {versions.map((v) => <option value={v.value}>{v.label}</option>)}
  </select>
</div>

<script define:vars={{ versions }}>
  const sel = document.getElementById('version-select');

  // Detect current version from URL.
  // v21 (current) lives at /components/... (no version prefix).
  // All others live at /vNN/components/...
  const versionedMatch = window.location.pathname.match(/^\/(v\d+)\//);
  const isUnversionedV21 = /^\/components\//.test(window.location.pathname);

  if (versionedMatch) sel.value = versionedMatch[1];
  else if (isUnversionedV21) sel.value = 'v21';

  sel.addEventListener('change', () => {
    const chosen = sel.value;
    const path = window.location.pathname;

    // Strip any existing version prefix to get the bare component path
    // e.g. "/v20/components/button/" → "components/button/"
    //      "/components/button/"     → "components/button/"
    const bare = path.replace(/^\/(v\d+\/)?/, '');

    const newPath = chosen === 'v21'
      ? `/${bare}`           // v21 has no prefix
      : `/${chosen}/${bare}`; // all others get the version prefix

    window.location.pathname = newPath;
  });
</script>

<style>
  .version-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .version-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
  }
  .version-select {
    font-size: 0.8rem;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    appearance: auto;
  }
</style>
